{
  "name": "@meter-app/service",
  "version": "0.1.0",
  "private": true,
  "description": "Meter app service v2 built with NestJS, Fastify, Prisma and Swagger",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" prisma.config.ts vitest.config.mts vitest.integration.config.mts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:prepare": "tsx test/integration/prepare-database.cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "openapi:write": "ts-node --project tsconfig.json scripts/write-openapi.ts",
    "preopenapi:write": "npm run prisma:generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/passport-jwt": "^4.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "jwks-rsa": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
