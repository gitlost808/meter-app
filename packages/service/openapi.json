  "info": {
    "title": "Meter App Service V2",
    "description": "REST API for meter app",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUnitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kilowattstunde"
          },
          "suffix": {
            "type": "string",
            "example": "kWh"
          }
        },
        "required": [
          "name",
          "suffix"
        ]
      },
      "CreateMeterTypeForUnitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Strom"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateUnitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kilowattstunde"
          },
          "suffix": {
            "type": "string",
            "example": "kWh"
          }
        }
      },
      "CreateMeterTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Strom"
          },
          "unitId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "name",
          "unitId"
        ]
      },
      "CreateMeterForMeterTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main electricity meter"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateMeterTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Strom"
          },
          "unitId": {
            "type": "number",
            "example": 1
          }
        }
      },
      "CreateMeterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main electricity meter"
          },
          "meterTypeId": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "name",
          "meterTypeId"
        ]
      },
      "CreateValueForMeterDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 1245.67
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          }
        },
        "required": [
          "value",
          "timestamp"
        ]
      },
      "UpdateMeterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main electricity meter"
          },
          "meterTypeId": {
            "type": "number",
            "example": 2
          }
        }
      },
      "CreateValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 1245.67
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          },
          "meterId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "value",
          "timestamp",
          "meterId"
        ]
      },
      "UpdateValueDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 1245.67
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          },
          "meterId": {
            "type": "number",
            "example": 1
          }
        }
      },
      "ValueWriteDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "update",
              "create"
            ],
            "description": "Update a value of the selected day or create a new one"
          },
          "valueId": {
            "type": "number",
            "example": 12,
            "description": "Required for kind \"update\""
          },
          "meterId": {
            "type": "number",
            "example": 3,
            "description": "Required for kind \"create\""
          },
          "value": {
            "type": "number",
            "example": 1245.67,
            "description": "Required for kind \"create\"; for \"update\", an omitted value leaves the stored value unchanged"
          }
        },
        "required": [
          "kind"
        ]
      },
      "NewMeterWriteDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "update",
              "create"
            ],
            "description": "Update the first value of an already created new meter, or create the new meter with its first value"
          },
          "valueId": {
            "type": "number",
            "example": 13,
            "description": "Required for kind \"update\""
          },
          "meterName": {
            "type": "string",
            "example": "Electricity 2026-10-16",
            "description": "Required for kind \"create\""
          },
          "value": {
            "type": "number",
            "example": 0.5,
            "description": "Required for kind \"create\"; for \"update\", an omitted value leaves the stored value unchanged"
          }
        },
        "required": [
          "kind"
        ]
      },
      "ValueEntryDto": {
        "type": "object",
        "properties": {
          "meterTypeId": {
            "type": "number",
            "example": 1
          },
          "value": {
            "$ref": "#/components/schemas/ValueWriteDto"
          },
          "newMeter": {
            "description": "Meter change: replace the meter of this type",
            "allOf": [
              {
                "$ref": "#/components/schemas/NewMeterWriteDto"
              }
            ]
          }
        },
        "required": [
          "meterTypeId"
        ]
      },
      "NoteWriteDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "description": "Create the note of the entry, or update or delete an existing note of the same day"
          },
          "noteId": {
            "type": "number",
            "example": 4,
            "description": "Required for kinds \"update\" and \"delete\""
          },
          "text": {
            "type": "string",
            "example": "Yearly meter check done",
            "maxLength": 2000,
            "description": "Required for kinds \"create\" and \"update\"; ignored for \"delete\""
          }
        },
        "required": [
          "kind"
        ]
      },
      "SaveValueEntriesDto": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "2026-10-16T00:00:00.000Z",
            "description": "Timestamp for all created values and the created note"
          },
          "entries": {
            "description": "May be empty when the request only saves a note",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValueEntryDto"
            }
          },
          "note": {
            "description": "The note of the entry; saved with the entry timestamp in the same transaction",
            "allOf": [
              {
                "$ref": "#/components/schemas/NoteWriteDto"
              }
            ]
          }
        },
        "required": [
          "timestamp",
          "entries"
        ]
      },
      "CreateNoteDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Yearly meter check done"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          }
        },
        "required": [
          "text",
          "timestamp"
        ]
      },
      "UpdateNoteDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Yearly meter check done"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-03-05T12:00:00.000Z"
          }
        }
      }
    }
  }
}